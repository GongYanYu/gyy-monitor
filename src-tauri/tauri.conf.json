{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gyy-monitor",
  "version": "1.0.0",
  "identifier": "com.gyy.monitor",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "gyy-monitor",
        "url": "index.html?mode=floating",
        "width": 800,
        "height": 60,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": true
      },
      {
        "label": "taskbar",
        "title": "gyy-monitor-taskbar",
        "url": "index.html?mode=taskbar",
        "width": 300,
        "height": 40,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
